# Variables d'environnement — copier dans .env.local et remplir
# .env.local est gitignored — ne JAMAIS commiter de vraies valeurs
# Sur Vercel : ajouter ces variables dans Settings > Environment Variables

# ── Site ──────────────────────────────────────────────────────────────────────
# URL de production (sans slash final)
NEXT_PUBLIC_SITE_URL=https://[domaine-client].fr

# ── Formulaire de contact (Resend) ────────────────────────────────────────────
# Clé API Resend — resend.com (plan gratuit : 3 000 emails/mois)
RESEND_API_KEY=re_xxxx

# Email de destination des leads (email professionnel du client)
CONTACT_EMAIL_TO=contact@[domaine-client].fr

# ── Rate limiting (optionnel — Upstash Redis) ─────────────────────────────────
# Nécessite un compte Upstash (upstash.com — plan gratuit disponible)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── CMS Sanity (optionnel — si galerie réalisations éditable par le client) ───
# Créer un projet sur sanity.io (plan gratuit : 10 GB, 500k req/mois)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=                        # token write — JAMAIS NEXT_PUBLIC_

# ── Monitoring d'erreurs (optionnel — Sentry) ─────────────────────────────────
# Créer un projet sur sentry.io (plan gratuit disponible)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
