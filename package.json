{
  "name": "mobem-starter-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "audit": "pnpm audit",
    "impeccable": "pnpm dlx impeccable detect src/",
    "impec-audit": "pnpm dlx impeccable detect src/ --json",
    "e2e": "playwright test",
    "livraison": "node scripts/generate-livraison-docx.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "tmp": ">=0.2.6",
      "uuid": ">=11.1.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-w5hq-g745-h8pq"
      ]
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "docx": "^9.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.9.3"
  }
}
