# Base URL (obligatoire)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Sanity CMS (optionnel — activer pour les projets avec blog/portfolio)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# Resend — Email transactionnel (optionnel)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Vercel Analytics (optionnel)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Figma MCP — Design ↔ Code sync (optionnel)
# Créer un token sur figma.com → Account → Personal access tokens
# FIGMA_API_KEY=figd_xxxxxxxxxxxxxxxxxxxx
